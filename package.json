    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4",
    "resend": "^6.9.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.0.0",
    "@types/react": "~19.2.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  },

{
  "name": "MecicaNario",
  "version": "1.5.1",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy": "npx convex deploy --yes && npx convex run --prod fixProductionCategories:fix",
    "deploy:dev": "npx convex dev --once && npx convex run fixProductionCategories:fix && node -e \"const fs=require('fs');const f='.env.local';let t=fs.readFileSync(f,'utf8');t=t.replace(/EXPO_PUBLIC_CONVEX_URL=.*/,'EXPO_PUBLIC_CONVEX_URL=https://enchanted-penguin-105.convex.cloud');fs.writeFileSync(f,t);console.log('Restored EXPO_PUBLIC_CONVEX_URL to production');\""
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@react-navigation/stack": "^7.4.5",
    "@typesafe-ai/sdk": "^0.6.0",
    "convex": "^1.26.1",
    "expo": "~55.0.27",
    "expo-apple-authentication": "~55.0.14",
    "expo-auth-session": "~55.0.17",
    "expo-av": "~16.0.8",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.16",
    "expo-gl": "~55.0.15",
    "expo-haptics": "~55.0.15",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "~55.0.15",
    "expo-notifications": "~55.0.24",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-speech": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-tracking-transparency": "~55.0.15",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.17",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^15.7.0",
    "react-native-purchases": "^9.11.0",
    "react-native-purchases-ui": "^9.11.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
